# Dev credentials. Copy to .env (gitignored) and fill in.
# Use a throwaway key holding test funds only.

# The Arkiv network, shared by every component.
ARKIV_RPC_URL=
# Optional: API key for a metered endpoint, sent as an Authorization: Bearer header.
# ARKIV_API_KEY=

# The file holding the key that signs entity writes, for the sidecar and
# the probes alike. In the compose stack this is writer.key next to
# compose.yaml, mounted as a secret (compose sets the path itself); the
# value here serves bare runs, which happen in writer/, so the path is
# relative to that directory.
WRITER_PRIVATE_KEY_FILE=../writer.key

# Where the sidecar listens. Loopback is right for the compose stack, which
# runs it on the host's network next to the LB; only a setup where the two
# do not share a network needs another host.
# WRITER_HOST=127.0.0.1
# WRITER_PORT=8560

# --- settle ------------------------------------------------------------
# The settle CLI reads the LB's records and pays what they are owed. It
# runs by hand or from a cron, off the LB host by preference, and takes
# no key while it is rehearsing.

# Whose records are paid, and whose receipts say a record is paid. The
# provider tooling ships both, and reads records and receipts by them,
# so a run under another settle address would pay records that are
# already paid and write receipts no provider would look at.
# LB_ADDRESS=
# SETTLE_ADDRESS=

# The payout chain: the endpoint, the chain it must answer for, and the
# GLM contract on it.
# PAYOUT_RPC_URL=
# PAYOUT_CHAIN_ID=
# GLM_TOKEN_ADDRESS=
