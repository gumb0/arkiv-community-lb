{
  "name": "arkiv-writer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Chain-writer sidecar for the Arkiv community LB: schema-blind entity operations over the official SDK, and the HTTP service around them.",
  "scripts": {
    "probes": "npm run writer-smoke && npm run service-smoke && npm run queries && npm run batch && npm run permanent && npm run page-budget && npm run replay && npm run paging",
    "writer-smoke": "node --env-file-if-exists=../.env probes/writer-smoke.ts",
    "service-smoke": "node --env-file-if-exists=../.env probes/service-smoke.ts",
    "queries": "node --env-file-if-exists=../.env probes/queries.ts",
    "batch": "node --env-file-if-exists=../.env probes/batch-experiment.ts",
    "permanent": "node --env-file-if-exists=../.env probes/permanent-probe.ts",
    "page-budget": "node --env-file-if-exists=../.env probes/page-budget.ts",
    "replay": "node --env-file-if-exists=../.env probes/replay-probe.ts",
    "paging": "node --env-file-if-exists=../.env probes/paging-probe.ts",
    "create-dup": "node --env-file-if-exists=../.env probes/create-dup.ts",
    "counters": "node --env-file-if-exists=../.env probes/counters-probe.ts",
    "read-after-write": "node --env-file-if-exists=../.env probes/read-after-write.ts",
    "gas-after-write": "node --env-file-if-exists=../.env probes/gas-after-write.ts",
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "service": "node --env-file-if-exists=../.env src/service.ts"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "viem": "^2.38.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
